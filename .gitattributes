# Normalize newly authored text while preserving byte-frozen scientific inputs.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.svg text eol=lf
experiments/thesis/manifests/* -text -eol
experiments/thesis/preregistration/* -text -eol
results/thesis-final/frozen-report/** -text -eol
results/thesis-final/publication-figures/* -text -eol
results/thesis-final/publication-figure-index.json -text -eol
results/thesis-final/safety-accounting-correction.csv -text -eol
results/thesis-final/safety-accounting-erratum.md -text -eol
experiments/thesis/archive/docx/* -text -eol
docs/history/** -text -eol
experiments/thesis/provenance/* -text -eol
experiments/historical/authored-scripts/* -text -eol
