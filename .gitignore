# Local configuration and secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx

# Python environments and dependency caches
.venv/
venv/
env/
.uv-cache/
.cache/
__pycache__/
*.py[cod]
*$py.class

# Python tooling and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.pyre/
.pytype/
.pyright/
.ipynb_checkpoints/
/.pytest-tmp-*/
/docs/generated/
/docs/render-tmp/

# Coverage, test, and profiling output
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml
pytest-debug.log
*.prof

# Package and build output
build/
dist/
*.egg-info/
.eggs/
wheels/

# Generated benchmark and experiment artifacts
# Runtime measurements, snapshots, and reports may be irreplaceable evidence.
# Keep them outside Git; curated authenticated publication copies live in results/.
artifacts/*
!artifacts/raw/
!artifacts/reports/
artifacts/raw/*
!artifacts/raw/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
artifacts-newpc/

# PostgreSQL and benchmark runtime output
pgbench_log.*
*.dump
*.db
*.sqlite
*.sqlite3
*.pid

# Logs and temporary/editor files
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# Local editor, agent, and OS metadata
.agents/
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
